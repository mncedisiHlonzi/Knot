# ---------------------------------------------------------------------------
# Knot — environment variable reference.
#
# Copy this file to `.env` and fill in real values locally.
# NEVER commit a real `.env` file or any real secret.
#
# Convention: names only here, no real credentials. See docs/DEVELOPMENT.md.
# ---------------------------------------------------------------------------

# --- Application ---
APP_ENV=development
APP_NAME=Knot
APP_VERSION=0.1.0

# --- Backend (Go) ---
BACKEND_HOST=localhost
BACKEND_PORT=8080

# --- Mobile (React Native) ---
MOBILE_API_BASE_URL=http://localhost:8080
# Read by apps/mobile/src/config/api.ts when the bundler inlines process.env.
# When it is absent the app falls back to the same value compiled into it.
KNOT_API_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Backend configuration — read by backend/go/internal/config.
#
# KNOT_ENV accepts: local | ci | test
#   * local (or unset) — safe local defaults are applied for any value below
#     that is left empty. The placeholder JWT secret is allowed, and the server
#     logs a prominent warning about it.
#   * ci / test        — KNOT_POSTGRES_DSN, KNOT_REDIS_ADDR, and KNOT_JWT_SECRET
#     are REQUIRED, the JWT secret must be at least 32 bytes, and the backend
#     fails fast naming anything that is missing.
# ---------------------------------------------------------------------------
KNOT_ENV=local
KNOT_POSTGRES_DSN=postgres://knot:knot_local_only_change_me@localhost:5433/knot?sslmode=disable
KNOT_REDIS_ADDR=localhost:6379
# Optional. The local docker-compose Redis requires no password, so this is
# empty; a real deployment sets it. Read verbatim — spaces are part of it.
KNOT_REDIS_PASSWORD=
# Optional. Redis's own default database is 0, which is what the local stack uses.
KNOT_REDIS_DB=0
# --- Precomputed feed (KNOT-036) ---
# The default (chronological) feed is precomputed in Redis on write and served from
# a single sorted-set read; GET /stories falls back to PostgreSQL on a miss. The
# `for_you` ranked feed always uses SQL. Set this to false to switch the cache off
# and take the pre-query path everywhere — the escape hatch if Redis is the problem.
KNOT_FEED_CACHE_ENABLED=true
# Past this many readers an author is "high-fanout": their stories are stored once
# in knot:author_feed:{author_id} instead of being written into every reader's feed.
KNOT_FEED_FANOUT_THRESHOLD=10000
# How many entries one reader's feed holds. The sorted set is trimmed to this size
# on every insert, which is what replaces a time to live.
KNOT_FEED_CAP=800
KNOT_HTTP_PORT=8080
KNOT_LOG_LEVEL=info
# Local placeholder only. Never reuse this value anywhere real.
KNOT_JWT_SECRET=change_me_in_local_development_min_32_chars
# Guards the operator-only endpoints (today: POST /admin/purge-deleted, the MVP
# account-purge trigger). Required outside `local`, like the JWT secret above.
KNOT_ADMIN_SECRET=knot_local_admin_secret_change_me

# --- Object storage (S3-compatible) — read by internal/config ---
# Which object store these settings point at: `minio` (the default, and what the
# local docker-compose stack runs) or `r2` (Cloudflare R2, the production store;
# KNOT-ADR-091). Both are spoken to through the same S3 client, so switching is
# configuration only — no code, no bucket-management API. The value is a label the
# backend checks and logs; anything else fails fast at startup.
#
# R2 (production) — replace the five values below with the ones from the R2
# dashboard. The endpoint is https://<account-id>.r2.cloudflarestorage.com, the
# region is `auto`, and the access key pair is the R2 API token's key id/secret.
# The bucket must already exist: nothing here creates it.
#   KNOT_STORAGE_PROVIDER=r2
#   KNOT_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   KNOT_S3_REGION=auto
#   KNOT_S3_ACCESS_KEY=<r2-access-key-id>
#   KNOT_S3_SECRET_KEY=<r2-secret-access-key>
#   KNOT_S3_BUCKET=knot-media
#
# MinIO (local, the values below) — the backend runs on the host and reaches the
# container over the host-mapped S3 port. Rejected uploads aside, the API mediates
# every read and write: the bucket is never public and the client never sees these
# credentials (KNOT-ADR-029). MinIO ignores the region, so `auto` (R2's value) is
# harmless here and one default serves both providers.
KNOT_STORAGE_PROVIDER=minio
KNOT_S3_ENDPOINT=http://127.0.0.1:9000
KNOT_S3_REGION=auto
KNOT_S3_ACCESS_KEY=knot
KNOT_S3_SECRET_KEY=knot_local_only_change_me
KNOT_S3_BUCKET=knot-media

# --- Email delivery (Resend) — read by internal/config ---
# Verification and password-reset emails are sent through Resend (KNOT-ADR-090).
# A real key looks like re_xxxxxxxx and is NEVER committed.
# Leave it empty to disable delivery: the backend then logs each message,
# including its link, which is the local-development round trip.
KNOT_RESEND_API_KEY=re_placeholder
# The From header. onboarding@resend.dev is the Resend sandbox sender and needs
# no verified domain; a deployment with its own domain sets e.g.
# "Knot <hello@knot.example>".
KNOT_EMAIL_FROM=Knot <onboarding@resend.dev>
# The origin behind the button in those emails. The link has to be https because
# many mail clients do not treat a custom knot:// scheme as tappable
# (KNOT-031a-fix). The default is a placeholder that resolves nowhere: set this
# to the real web origin before anyone relies on the link. The raw token is shown
# in every email as well, so a broken link is never a dead end.
KNOT_WEB_URL=https://knot.local

# ---------------------------------------------------------------------------
# Local development infrastructure — consumed by
# infrastructure/docker/docker-compose.yml and the scripts in scripts/.
#
# These are LOCAL-ONLY placeholder values, not secrets. Change them freely on
# your machine; never reuse them anywhere real.
#
# KNOT_POSTGRES_PORT is the HOST port only. Knot's local Postgres is published on
# 5433 rather than the conventional database port, so it cannot clash with a
# Postgres already installed on the developer's machine. The container's internal
# port is unchanged.
# ---------------------------------------------------------------------------
KNOT_POSTGRES_USER=knot
KNOT_POSTGRES_PASSWORD=knot_local_only_change_me
KNOT_POSTGRES_DB=knot
KNOT_POSTGRES_PORT=5433
KNOT_REDIS_PORT=6379
# MinIO: 9000 is the S3 API the backend dials, 9001 is the web console.
KNOT_MINIO_ROOT_USER=knot
KNOT_MINIO_ROOT_PASSWORD=knot_local_only_change_me
KNOT_MINIO_PORT=9000
KNOT_MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# Reserved for later phases — NOT used yet. Placeholders only.
#
# JWT_SECRET was removed in KNOT-003: KNOT_JWT_SECRET above is the real one.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
