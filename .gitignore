# ---------------------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Local client-side secrets (KNOT-ADR-027): each is created locally by copying its
# committed `.example` template, and is never committed. Only the `.example`
# files and the `secrets.local.d.ts` type shim are tracked.
apps/mobile/src/config/secrets.local.ts
apps/mobile/android/app/src/main/res/values/mapbox.xml

# ---------------------------------------------------------------------------
# Node / JavaScript
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# React Native / Expo build output
# ---------------------------------------------------------------------------
.expo/
dist/
web-build/
coverage/
*.jks
*.keystore
**/android/.gradle/
**/android/app/build/
**/ios/Pods/
**/ios/build/

# ---------------------------------------------------------------------------
# Go
# ---------------------------------------------------------------------------
bin/
*.exe
*.test
*.out
vendor/

# ---------------------------------------------------------------------------
# IDE / editors
# ---------------------------------------------------------------------------
.idea/
*.swp
*.swo

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Logs / misc
# ---------------------------------------------------------------------------
*.log

# ---------------------------------------------------------------------------
# Native mobile (apps/mobile/ios, apps/mobile/android)
# ---------------------------------------------------------------------------
# iOS
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/ios/DerivedData/
**/.xcode.env.local
apps/mobile/ios/*.xcworkspace
!apps/mobile/ios/Knot.xcworkspace
# Podfile.lock is generated on the first successful pod install; the founder
# commits it deliberately after that build (KNOT-008a).
apps/mobile/ios/Podfile.lock

# Android
apps/mobile/android/.gradle/
apps/mobile/android/build/
apps/mobile/android/app/build/
apps/mobile/android/local.properties
apps/mobile/android/.cxx/
# The debug keystore is a shared, non-secret development artefact.
!apps/mobile/android/app/debug.keystore
