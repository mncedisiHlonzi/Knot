<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext policy for the local video cache (KNOT-037-fix10).

  react-native-video-cache plays a story's stream through a proxy it runs on
  `127.0.0.1`, so the player reads the video over plain HTTP from the device
  itself. Android blocks cleartext by default for apps targeting API 28+, which
  would make every cached stream fail in a release build while working in debug
  (the debug manifest sets `usesCleartextTraffic="true"`).

  The exception is deliberately scoped: ONLY loopback is allowed cleartext, so the
  API's own HTTPS requirement is untouched.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
