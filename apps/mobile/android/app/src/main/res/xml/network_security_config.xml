<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext policy for the local video cache (KNOT-037-fix10, KNOT-037-fix11).

  This is the RELEASE policy. `react-native-video-cache` plays a story's stream
  through a proxy it runs on `127.0.0.1`, so the player reads the video over plain
  HTTP from the device itself. Android blocks cleartext by default for apps
  targeting API 28+, which would make every cached stream fail.

  The exception is deliberately scoped: ONLY loopback is allowed cleartext, so a
  release build still requires HTTPS for the API and every other host.

  Debug builds do NOT use this file: `src/debug/res/xml/network_security_config.xml`
  overrides it, because a debug build must also reach the developer's machine over
  plain HTTP (KNOT-037-fix11).
-->
<network-security-config>
    <!-- No cleartext by default: a release API URL must be HTTPS. -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- The one exception: the on-device video cache proxy. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
