<resources>
    <string name="app_name">Knot</string>
    <!-- react-native-maps requires a Google Maps Android API key. This is a
         deliberate placeholder so that no real key is committed: replace it
         locally (or inject it per environment) before building for Android. -->
    <string name="google_maps_api_key">YOUR_GOOGLE_MAPS_API_KEY_HERE</string>
    <!-- The Mapbox access token is deliberately NOT defined here. It lives in
         `res/values/mapbox.xml`, which is gitignored so no token is ever
         committed (KNOT-ADR-027); copy `res/values/mapbox.example.xml` to create
         it. The manifest references it as `com.mapbox.token`. -->
</resources>
