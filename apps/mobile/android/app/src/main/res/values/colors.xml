<resources>
    <!-- The splash background, in the app's canvas colour. It used to be the
         brand's purple (#7B3FE4); Knot is monochrome now, so the first frame of
         the app is its own background rather than a coloured block (KNOT-020k).
         `values-night/colors.xml` holds the dark pair. -->
    <color name="knot_splash_background">#FFFFFF</color>

    <!-- The app's canvas, `colors.bg.canvas` in src/theme/colors.ts (which reads
         `palette.light.canvas`). Declared here as well because the system bars
         are painted by the Android window before any JavaScript runs, so they
         cannot read a theme token: the value is duplicated in the two layers that
         each need it, and the two must be changed together (KNOT-020g-fix8). -->
    <color name="knot_canvas">#FFFFFF</color>
</resources>
