<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- Solid canvas background shown before React Native mounts (splash).
             The colour is defined in res/values/colors.xml and its dark pair in
             res/values-night/colors.xml: the app is monochrome, so the splash is
             the canvas itself (KNOT-020k). -->
        <item name="android:windowBackground">@color/knot_splash_background</item>

        <!-- The system bars, in the app's canvas colour (knot_canvas). Both are
             painted by the window, so they take effect before React Native mounts
             and survive every screen; App.tsx also declares the status bar so the
             two agree once JavaScript runs. `windowLightStatusBar` and
             `windowLightNavigationBar` add the dark icons that a light bar needs —
             without them the clock and the gesture pill would be white on white.
             The navigation bar's attribute is API 27+, so on API 24-26 the bar is
             still white but keeps its default light icons (KNOT-020g-fix8).

             These values are the PRE-MOUNT defaults only. The app's theme is
             user-selectable, and a native theme cannot read that choice, so
             navigationBarColor is repainted at runtime by the app-local
             SystemBarsModule (see src/native/systemBars.ts) whenever the active
             theme changes — light canvas with dark icons, or dark canvas with
             light icons (KNOT-020j). The status bar is likewise re-declared from
             JavaScript by App.tsx. -->
        <item name="android:statusBarColor">@color/knot_canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/knot_canvas</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>
