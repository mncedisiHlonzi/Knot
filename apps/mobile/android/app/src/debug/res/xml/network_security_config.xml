<?xml version="1.0" encoding="utf-8"?>
<!--
  The DEBUG network policy (KNOT-037-fix11).

  A debug build talks to the backend on the developer's own machine over plain
  HTTP: `DEV_API_URL` in `src/config/dev.ts` is a LAN address such as
  http://10.92.86.173:8080, and there is no certificate for it. Android denies
  cleartext for apps targeting API 28+, so without this override every API call
  fails with "Network request failed" — the login screen cannot even reach the
  server.

  This file lives in the `debug` build-type source set, so it REPLACES
  `src/main/res/xml/network_security_config.xml` for debug builds only. A release
  build keeps the main policy: no cleartext at all except the local video-cache
  proxy. That is why this permission is debug-scoped rather than global.

  ⚠️ `android:usesCleartextTraffic` in a manifest is IGNORED once a
  networkSecurityConfig is attached, and this app has declared one since
  KNOT-037-fix10 (minSdk 24, targetSdk 34). The debug manifest's
  `usesCleartextTraffic="true"` was therefore inert, which is exactly how the
  regression reached a device. Cleartext is granted HERE, where the platform
  actually reads it.
-->
<network-security-config>
    <!--
      Debug builds may use cleartext to any host: the developer's LAN address
      changes with the Wi-Fi network, so listing one IP would break again on the
      next network. This file is never part of a release build.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
